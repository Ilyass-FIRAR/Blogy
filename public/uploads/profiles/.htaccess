# Prevent directory listing
Options -Indexes

# Prevent script execution
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|cgi|pl|exe|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Only allow image files
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

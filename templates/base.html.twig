<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}MyBlog - Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4" href="{{ path('app_home') }}" style="color: #2563eb;">Bloggy</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home') }}">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_articles') }}">Articles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">About</a>
                        </li>
                    </ul>
                    <div class="d-flex gap-2 align-items-center">
                        {% if app.user %}
                            <a class="nav-link" href="{{ path('app_profile') }}" title="My Profile">
                                {% if app.user.profilePicture %}
                                    <img src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}" 
                                         alt="{{ app.user.username }}" 
                                         class="rounded-circle"
                                         style="width: 32px; height: 32px; object-fit: cover;">
                                {% else %}
                                    <span class="badge bg-secondary rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 14px;">
                                        {{ app.user.username|first|upper }}
                                    </span>
                                {% endif %}
                            </a>
                            <span class="navbar-text me-2">{{ app.user.username }}</span>
                            <a class="btn btn-outline-primary" href="{{ path('app_logout') }}">Logout</a>
                        {% else %}
                            <a class="btn btn-link text-decoration-none text-dark" href="{{ path('app_login') }}">Login</a>
                            <a class="btn btn-primary px-4" href="{{ path('app_register') }}" style="background-color: #2563eb; border-color: #2563eb;">Register</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
        <!-- Main Content -->
        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- Bootstrap 5 JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>

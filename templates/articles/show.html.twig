{% extends "base.html.twig" %}

{% block title %}{{ article.title }} - Blogy{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <!-- Article Header -->
            <article class="mb-5">
                <header class="mb-4 pb-4 border-bottom">
                    <h1>{{ article.title }}</h1>
                    <p class="text-muted mb-2">
                        <i class="bi bi-person-circle"></i> 
                        <strong>{{ article.user.email }}</strong>
                    </p>
                    <p class="text-muted small">
                        <i class="bi bi-calendar-event"></i>
                        {{ article.createdAt|date('d F Y') }} at {{ article.createdAt|date('H:i') }}
                    </p>
                </header>

                <!-- Article Content -->
                <div class="article-content mb-5 lh-lg">
                    {{ article.content }}
                </div>

                <!-- Article Meta -->
                <footer class="d-flex justify-content-between align-items-center py-3 border-top">
                    <div class="stats">
                        <span class="badge bg-info me-2">
                            💬 {{ article.comments|length }} Comment{{ article.comments|length != 1 ? 's' : '' }}
                        </span>
                        <span class="badge bg-danger">
                            ❤️ {{ article.likes|length }} Like{{ article.likes|length != 1 ? 's' : '' }}
                        </span>
                    </div>

                    <!-- Edit/Delete buttons (only for author) -->
                    {% if app.user and app.user.id == article.user.id %}
                        <div class="btn-group" role="group">
                            <a href="{{ path('app_article_edit', {id: article.id}) }}" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form method="post" action="{{ path('app_article_delete', {id: article.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this article?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-article' ~ article.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    {% endif %}

                    <!-- Like/Unlike buttons -->
                    {% if app.user %}
                        {% set userLiked = article.likes|filter(l => l.user.id == app.user.id)|length > 0 %}
                        <div class="btn-group" role="group">
                            {% if not userLiked %}
                                <form method="post" action="{{ path('app_article_like', {id: article.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                    <button type="submit" class="btn btn-outline-danger">
                                        ❤️ Like
                                    </button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('app_article_unlike', {id: article.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                    <button type="submit" class="btn btn-outline-secondary">
                                        💔 Unlike
                                    </button>
                                </form>
                            {% endif %}
                            <button type="button" class="btn btn-outline-primary" onclick="copyArticleLink()">
                                🔗 Share
                            </button>
                        </div>
                        <div id="share-toast" class="text-success small mt-2 d-none">Link copied to clipboard</div>
                    {% endif %}
                </footer>
            </article>

            <!-- Back Button -->
            <div class="mb-4">
                <a href="{{ path('app_articles') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Articles
                </a>
            </div>

            <!-- Comments Section -->
            <section class="comments-section mt-5 pt-5 border-top">
                <h3>💬 Comments ({{ article.comments|length }})</h3>

                {% if app.user %}
                    <!-- Comment Form -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">Leave a Comment</h5>
                            <form method="post" action="{{ path('app_comment_store', {articleId: article.id}) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                <div class="mb-3">
                                    <textarea 
                                        class="form-control" 
                                        name="content" 
                                        rows="4"
                                        placeholder="Share your thoughts..."
                                        required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-chat-left-text"></i> Post Comment
                                </button>
                            </form>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        <a href="{{ path('app_login') }}" class="alert-link">Login</a> to comment on this article.
                    </div>
                {% endif %}

                <!-- Comments List -->
                {% if article.comments|length > 0 %}
                    <div class="comments-list">
                        {% for comment in article.comments %}
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">
                                        <strong>{{ comment.user.email }}</strong> 
                                        - {{ comment.createdAt|date('d/m/Y H:i') }}
                                    </h6>
                                    <p class="card-text">{{ comment.content }}</p>
                                    {% if app.user and app.user.id == comment.user.id %}
                                        <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" style="display:inline;" onsubmit="return confirm('Delete this comment?');">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted">No comments yet. Be the first to comment!</p>
                {% endif %}
            </section>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function copyArticleLink() {
            if (!navigator.clipboard || !window.isSecureContext) {
                const temp = document.createElement('input');
                temp.value = window.location.href;
                document.body.appendChild(temp);
                temp.select();
                document.execCommand('copy');
                document.body.removeChild(temp);
                showShareToast();
                return;
            }

            navigator.clipboard.writeText(window.location.href)
                .then(showShareToast)
                .catch(() => showShareToast());
        }

        function showShareToast() {
            const toast = document.getElementById('share-toast');
            if (!toast) return;
            toast.classList.remove('d-none');
            setTimeout(() => toast.classList.add('d-none'), 2000);
        }
    </script>
{% endblock %}

{% extends "base.html.twig" %}

{% block title %}Articles - MyBlog{% endblock %}

{% block body %}
<div class="container">
    <section class="articles-section py-5">
        <h1 class="mb-5">Blog Articles</h1>

        {% if articles|length > 0 %}
            <div class="row g-4">
                {% for article in articles %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">{{ article.title }}</h5>
                                <p class="card-text text-muted small">
                                    By <strong>{{ article.user.email }}</strong> 
                                    on <em>{{ article.createdAt|date('d/m/Y') }}</em>
                                </p>
                                <p class="card-text">
                                    {{ article.content|slice(0, 100) }}{% if article.content|length > 100 %}...{% endif %}
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        💬 {{ article.comments|length }} | ❤️ {{ article.likes|length }}
                                    </small>
                                    <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-sm btn-primary">
                                        Read More
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">No Articles Yet</h4>
                <p>There are currently no blog articles. Check back soon!</p>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
